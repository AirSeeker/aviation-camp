              111.28997039794922
            ]
          },
          {
            "type": "text",
            "text": "SERA.10001 Application ",
            "font_name": "Calibri-Bold",
            "font_size": 15.960000038146973,
            "color": "#FFFFFF",
            "is_bold": true,
            "is_italic": false,
            "bbox": [
              72.02400207519531,
              133.60995483398438,
              234.17697143554688,
              149.56996154785156
            ]
          },
          {
            "type": "text",
            "text": "(a) ",
            "font_name": "Calibri",
            "font_size": 11.039999961853027,
            "color": "#000000",
            "is_bold": false,
            "is_italic": false,
            "bbox": [
              72.02400207519531,
              166.69998168945312,
              86.51904296875,
              177.73997497558594
            ]
          },
          {
            "type": "text",
            "text": "Alerting service shall be provided by the air traffic services units: ",
            "font_name": "Calibri",
            "font_size": 11.039999961853027,
            "color": "#000000",
            "is_bold": false,
            "is_italic": false,
            "bbox": [
              100.33999633789062,
              166.69998168945312,
              390.5250244140625,
              177.73997497558594
            ]
          },
          {
            "type": "text",
            "text": "(1) ",
            "font_name": "Calibri",
            "font_size": 11.039999961853027,
            "color": "#000000",
            "is_bold": false,
            "is_italic": false,
            "bbox": [
              100.33999633789062,
              186.13998413085938,
              115.07504272460938,
              197.1799774169922
            ]
          },
          {
            "type": "text",
            "text": "for all aircraft provided with air traffic control service; ",
            "font_name": "Calibri",
            "font_size": 11.039999961853027,
            "color": "#000000",
            "is_bold": false,
            "is_italic": false,
            "bbox": [
              128.66000366210938,
              186.13998413085938,
              371.20501708984375,
              197.1799774169922
            ]
          },
          {
            "type": "text",
            "text": "(2) ",
            "font_name": "Calibri",
            "font_size": 11.039999961853027,
            "color": "#000000",
            "is_bold": false,
            "is_italic": false,
            "bbox": [
              100.33999633789062,
              205.45999145507812,
              115.07504272460938,
              216.49998474121094
            ]
          },
          {
            "type": "text",
            "text": "in so far as practicable, to all other aircraft having filed a flight plan or otherwise known ",
            "font_name": "Calibri",
            "font_size": 11.039999961853027,
            "color": "#000000",
            "is_bold": false,
            "is_italic": false,
            "bbox": [
              128.66000366210938,
              205.45999145507812,
              525.8173217773438,
              216.49998474121094
            ]
          },
          {
            "type": "text",
            "text": "to the air traffic services; and ",
            "font_name": "Calibri",
            "font_size": 11.039999961853027,
            "color": "#000000",
            "is_bold": false,
            "is_italic": false,
            "bbox": [
              128.66000366210938,
              218.89999389648438,
              261.6250305175781,
              229.9399871826172
            ]
          },
          {
            "type": "text",
            "text": "(3) ",
            "font_name": "Calibri",
            "font_size": 11.039999961853027,
            "color": "#000000",
            "is_bold": false,
            "is_italic": false,
            "bbox": [
              100.33999633789062,
              238.33999633789062,
              115.07504272460938,
              249.37998962402344
            ]
          },
          {
            "type": "text",
            "text": "to any aircraft known or believed to be the subject of unlawful interference. ",
            "font_name": "Calibri",
            "font_size": 11.039999961853027,
            "color": "#000000",
            "is_bold": false,
            "is_italic": false,
            "bbox": [
              128.66000366210938,
              238.33999633789062,
              470.95501708984375,
              249.37998962402344
            ]
          },
          {
            "type": "text",
            "text": "(b) ",
            "font_name": "Calibri",
            "font_size": 11.039999961853027,
            "color": "#000000",
            "is_bold": false,
            "is_italic": false,
            "bbox": [
              72.02400207519531,
              257.7799987792969,
              86.99903869628906,
              268.82000732421875
            ]
          },
          {
            "type": "text",
            "text": "Unless otherwise prescribed by the competent authority, aircraft equipped with suitable twoway radio-communications shall report during the period 20 to 40 minutes following the time ",
            "font_name": "Calibri",
            "font_size": 11.039999961853027,
            "color": "#000000",
            "is_bold": false,
            "is_italic": false,
            "bbox": [
              100.33999633789062,
              257.7799987792969,
              523.438232421875,
              268.82000732421875
            ]
          },
          {
            "type": "text",
            "text": "of the last contact, whatever the purpose of such contact, merely to indicate that the flight is ",
            "font_name": "Calibri",
            "font_size": 11.039999961853027,
            "color": "#000000",
            "is_bold": false,
            "is_italic": false,
            "bbox": [
              100.33999633789062,
              284.6899719238281,
              525.86572265625,
              295.72998046875
            ]
          },
          {
            "type": "text",
            "text": "progressing according to plan, such report to comprise identification of the aircraft and the ",
            "font_name": "Calibri",
            "font_size": 11.039999961853027,
            "color": "#000000",
            "is_bold": false,
            "is_italic": false,
            "bbox": [
              100.33999633789062,
              298.1299743652344,
              525.6448364257812,
              309.16998291015625
            ]
          },
          {
            "type": "text",
            "text": "words ‘Operations normal’. ",
            "font_name": "Calibri",
            "font_size": 11.039999961853027,
            "color": "#000000",
            "is_bold": false,
            "is_italic": false,
            "bbox": [
              100.33999633789062,
              311.5699768066406,
              225.38504028320312,
              322.6099853515625
            ]
          },
          {
            "type": "text",
            "text": "(c) ",
            "font_name": "Calibri",
            "font_size": 11.039999961853027,
            "color": "#000000",
            "is_bold": false,
            "is_italic": false,
            "bbox": [
              72.02400207519531,
              331.0099792480469,
              85.79904174804688,
              342.04998779296875
            ]
          },
          {
            "type": "text",
            "text": "The ‘Operations normal’ message shall be transmitted air-ground to an appropriate ATS unit. ",
            "font_name": "Calibri",
            "font_size": 11.039999961853027,
            "color": "#000000",
            "is_bold": false,
            "is_italic": false,
            "bbox": [
              100.33999633789062,
              331.0099792480469,
              517.9950561523438,
              342.04998779296875
            ]
          },
          {
            "type": "text",
            "text": "GM1 SERA.10001 Application ",
            "font_name": "Calibri-Bold",
            "font_size": 15.960000038146973,
            "color": "#FFFFFF",
            "is_bold": true,
            "is_italic": false,
            "bbox": [
              72.02400207519531,
              363.4399719238281,
              270.0569763183594,
              379.39996337890625
            ]
          },
          {
            "type": "text",
            "text": "ALERTING SERVICE — PROMULGATION OF NOTAMs FOR SEARCH AND RESCUE OPERATIONS ",
            "font_name": "Calibri-Bold",
            "font_size": 11.039999961853027,
            "color": "#000000",
            "is_bold": true,
            "is_italic": false,
            "bbox": [
              72.02400207519531,
              396.5299987792969,
              493.8750305175781,
              407.57000732421875
            ]
          },
          {
            "type": "text",
            "text": "It may be advisable, in case of a search and rescue operation of a substantial duration, to promulgate ",
            "font_name": "Calibri",
            "font_size": 11.039999961853027,
            "color": "#000000",
            "is_bold": false,
            "is_italic": false,
            "bbox": [
              72.02400207519531,
              415.8499755859375,
              525.7348022460938,
              426.8899841308594
            ]
          },
          {
            "type": "text",
            "text": "by NOTAM the lateral and vertical limits of the area of a search and rescue action, and to warn aircraft ",
            "font_name": "Calibri",
            "font_size": 11.039999961853027,
            "color": "#000000",
            "is_bold": false,
            "is_italic": false,
            "bbox": [
              72.02400207519531,
              429.28997802734375,
              525.8119506835938,
              440.3299865722656
            ]
          },
          {
            "type": "text",
            "text": "not engaged in actual search and rescue operations and not controlled by air traffic control service to ",
            "font_name": "Calibri",
            "font_size": 11.039999961853027,
            "color": "#000000",
            "is_bold": false,
            "is_italic": false,
            "bbox": [
              72.02400207519531,
              442.72998046875,
              525.8289794921875,
              453.7699890136719
            ]
          },
          {
            "type": "text",
            "text": "avoid such areas unless otherwise authorised by the appropriate air traffic services unit. ",
            "font_name": "Calibri",
            "font_size": 11.039999961853027,
            "color": "#000000",
            "is_bold": false,
            "is_italic": false,
            "bbox": [
              72.02400207519531,
              456.16998291015625,
              467.59503173828125,
              467.2099914550781
            ]
          },
          {
            "type": "text",
            "text": "GM1 SERA.10001(b)   Application ",
            "font_name": "Calibri-Bold",
            "font_size": 15.960000038146973,
            "color": "#FFFFFF",
            "is_bold": true,
            "is_italic": false,
            "bbox": [
              72.02400207519531,
              488.739990234375,
              295.8569641113281,
              504.6999816894531
            ]
          },
          {
            "type": "text",
            "text": "The absence of an ‘operations normal’ message does not constitute a situation of urgency. In the ",
            "font_name": "Calibri",
            "font_size": 11.039999961853027,
            "color": "#000000",
            "is_bold": false,
            "is_italic": false,
            "bbox": [
              72.02400207519531,
              521.7099609375,
              525.602294921875,
              532.75
            ]
          },
          {
            "type": "text",
            "text": "absence of such a report, ATS should endeavour to contact the aircraft on available frequencies. A ",
            "font_name": "Calibri",
            "font_size": 11.039999961853027,
            "color": "#000000",
            "is_bold": false,
            "is_italic": false,
            "bbox": [
              72.02400207519531,
              535.1499633789062,
              525.5913696289062,
              546.1900024414062
            ]
          },
          {
            "type": "text",
            "text": "failure to contact the aircraft could lead to any type of measure including the declaration of ",
            "font_name": "Calibri",
            "font_size": 11.039999961853027,
            "color": "#000000",
            "is_bold": false,
            "is_italic": false,
            "bbox": [
              72.02400207519531,
              548.5899658203125,
              525.8302001953125,
              559.6300048828125
            ]
          },
          {
            "type": "text",
            "text": "‘uncertainty phase’. ",
            "font_name": "Calibri",
            "font_size": 11.039999961853027,
            "color": "#000000",
            "is_bold": false,
            "is_italic": false,
            "bbox": [
              72.02400207519531,
              562.0299682617188,
              163.31504821777344,
              573.0700073242188
            ]
          },
          {
            "type": "text",
            "text": "SERA.10005 Information to aircraft operating in the vicinity of an ",
            "font_name": "Calibri-Bold",
            "font_size": 15.960000038146973,
            "color": "#FFFFFF",
            "is_bold": true,
            "is_italic": false,
            "bbox": [
              72.02400207519531,
              594.4600219726562,
              506.1840515136719,
              610.4199829101562
            ]
          },
          {
            "type": "text",
            "text": "aircraft in a state of emergency ",
            "font_name": "Calibri-Bold",
            "font_size": 15.960000038146973,
            "color": "#FFFFFF",
            "is_bold": true,
            "is_italic": false,
            "bbox": [
              72.02400207519531,
              614.02001953125,
              283.0169677734375,
              629.97998046875
            ]
          },
          {
            "type": "text",
            "text": "(a) ",
            "font_name": "Calibri",
            "font_size": 11.039999961853027,
            "color": "#000000",
            "is_bold": false,
            "is_italic": false,
            "bbox": [
              72.02400207519531,
              647.0199584960938,
              86.51904296875,
              658.0599975585938
            ]
          },
          {
            "type": "text",
            "text": "When it has been established by an air traffic services unit that an aircraft is in a state of ",
            "font_name": "Calibri",
            "font_size": 11.039999961853027,
            "color": "#000000",
            "is_bold": false,
            "is_italic": false,
            "bbox": [
              100.33999633789062,
              647.0199584960938,
              525.611572265625,
              658.0599975585938
            ]
          },
          {
            "type": "text",
            "text": "emergency, other aircraft known to be in the vicinity of the aircraft involved shall, except as ",
            "font_name": "Calibri",
            "font_size": 11.039999961853027,
            "color": "#000000",
            "is_bold": false,
            "is_italic": false,
            "bbox": [
              100.33999633789062,
              660.4599609375,
              525.5676879882812,
              671.5
            ]
          },
          {
            "type": "text",
            "text": "provided in (b), be informed of the nature of the emergency as soon as practicable. ",
            "font_name": "Calibri",
            "font_size": 11.039999961853027,
            "color": "#000000",
            "is_bold": false,
            "is_italic": false,
            "bbox": [
              100.33999633789062,
              673.8999633789062,
              474.5550231933594,
              684.9400024414062
            ]
          },
          {
            "type": "text",
            "text": "(b) ",
            "font_name": "Calibri",
            "font_size": 11.039999961853027,
            "color": "#000000",
            "is_bold": false,
            "is_italic": false,
            "bbox": [
              72.02400207519531,
              693.3399658203125,
              86.99903869628906,
              704.3800048828125
            ]
          },
          {
            "type": "text",
            "text": "When an air traffic services unit knows or believes that an aircraft is being subjected to unlawful ",
            "font_name": "Calibri",
            "font_size": 11.039999961853027,
            "color": "#000000",
            "is_bold": false,
            "is_italic": false,
            "bbox": [
              100.33999633789062,
              693.3399658203125,
              525.8766479492188,
              704.3800048828125
            ]
          },
          {
            "type": "text",
            "text": "interference, no reference shall be made in ATS air-ground communications to the nature of ",
            "font_name": "Calibri",
            "font_size": 11.039999961853027,
            "color": "#000000",
            "is_bold": false,
            "is_italic": false,
            "bbox": [
              100.33999633789062,
              706.7799682617188,
              525.790283203125,
              717.8200073242188
            ]
          },
          {
            "type": "text",
            "text": "the emergency unless it has first been referred to in communications from the aircraft involved ",
            "font_name": "Calibri",
            "font_size": 11.039999961853027,
            "color": "#000000",
            "is_bold": false,
            "is_italic": false,
            "bbox": [
              100.33999633789062,
              720.219970703125,
              525.8528442382812,
              731.260009765625
            ]
          },
          {
            "type": "text",
            "text": "and it is certain that such reference will not aggravate the situation. ",
            "font_name": "Calibri",
            "font_size": 11.039999961853027,
            "color": "#000000",
            "is_bold": false,
            "is_italic": false,
            "bbox": [
              100.33999633789062,
              733.6559448242188,
              405.5250244140625,
              744.6959838867188
            ]
          },
          {
            "type": "text",
            "text": "Powered by EASA eRules ",
            "font_name": "Calibri-Italic",
            "font_size": 11.039999961853027,
            "color": "#000000",
            "is_bold": false,
            "is_italic": true,
            "bbox": [
              72.50399780273438,
              781.2959594726562,
              184.19503784179688,
              792.3359985351562
            ]
          },
          {
            "type": "text",
            "text": "SECTION 10 Alerting service ",
            "font_name": "Calibri-Italic",
            "font_size": 9.0,
            "color": "#000000",
            "is_bold": false,
            "is_italic": true,
            "bbox": [
