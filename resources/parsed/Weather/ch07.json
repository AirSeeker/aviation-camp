          },
          {
            "type": "text",
            "text": "Earth-Atmosphere Heat Imbalances ",
            "font_name": "TimesNewRomanPSMT",
            "font_size": 28.020000457763672,
            "color": "#000000",
            "is_bold": false,
            "is_italic": false,
            "bbox": [
              100.80000305175781,
