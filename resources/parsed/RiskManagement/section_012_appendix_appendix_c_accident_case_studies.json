              277.3313293457031
            ]
          },
          {
            "type": "text",
            "text": "12514",
            "font_name": "Arial-ItalicMT",
            "font_size": 9.0,
            "color": "#FFFFFF",
            "is_bold": false,
            "is_italic": true,
            "bbox": [
              54.0,
              279.0630798339844,
              79.0199966430664,
              288.0630798339844
            ]
          },
          {
            "type": "text",
            "text": "The collective risk severity level for this accident was catastrophic. The risk likelihood was at least occasional, producing a high ",
            "font_name": "TimesNewRomanPSMT",
            "font_size": 10.0,
            "color": "#000000",
            "is_bold": false,
            "is_italic": false,
            "bbox": [
              54.0,
              289.13134765625,
              560.4932250976562,
              299.13134765625
            ]
          },
          {
            "type": "text",
            "text": "overall risk level. Avoiding nighttime operations at this particular airport could have been a key mitigation.",
            "font_name": "TimesNewRomanPSMT",
            "font_size": 10.0,
            "color": "#000000",
            "is_bold": false,
            "is_italic": false,
            "bbox": [
              54.0,
              300.13134765625,
              481.81158447265625,
              310.13134765625
            ]
          },
          {
            "type": "text",
            "text": "Accident Profile 4: Fatal Turbojet-Powered Airplane Accident",
            "font_name": "Arial-BoldMT",
            "font_size": 11.0,
            "color": "#AA1E22",
            "is_bold": true,
            "is_italic": false,
            "bbox": [
