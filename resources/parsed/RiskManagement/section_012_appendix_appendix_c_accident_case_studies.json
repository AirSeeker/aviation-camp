              79.0199966430664,
              393.4631652832031
            ]
          },
          {
            "type": "text",
            "text": "•\t Date: 12/29/2016",
            "font_name": "TimesNewRomanPSMT",
            "font_size": 10.0,
            "color": "#000000",
            "is_bold": false,
            "is_italic": false,
            "bbox": [
