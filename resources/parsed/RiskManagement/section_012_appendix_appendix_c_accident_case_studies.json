              90.0127182006836,
              158.3199920654297,
              100.0127182006836
            ]
          },
          {
            "type": "text",
            "text": "]. This single action addresses both the environmental and aircraft performance risks. This ",
            "font_name": "TimesNewRomanPSMT",
            "font_size": 10.0,
            "color": "#000000",
            "is_bold": false,
            "is_italic": false,
            "bbox": [
