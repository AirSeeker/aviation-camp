              362.6630859375,
              79.0199966430664,
              371.6630859375
            ]
          },
          {
            "type": "text",
            "text": "•\t Location: Cleveland, OH",
            "font_name": "TimesNewRomanPSMT",
            "font_size": 10.0,
            "color": "#000000",
            "is_bold": false,
            "is_italic": false,
            "bbox": [
