              404.53143310546875
            ]
          },
          {
            "type": "text",
            "text": "12491",
            "font_name": "Arial-ItalicMT",
            "font_size": 9.0,
            "color": "#FFFFFF",
            "is_bold": false,
            "is_italic": true,
            "bbox": [
