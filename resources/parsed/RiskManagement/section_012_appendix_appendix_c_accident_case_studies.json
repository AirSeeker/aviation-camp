              79.0199966430664,
              415.2630615234375
            ]
          },
          {
            "type": "text",
            "text": "•\t NTSB Defining Event: Loss of control in-flight",
            "font_name": "TimesNewRomanPSMT",
            "font_size": 10.0,
            "color": "#000000",
            "is_bold": false,
            "is_italic": false,
            "bbox": [
              76.5,
