              560.5301513671875,
              266.3313293457031
            ]
          },
          {
            "type": "text",
            "text": "and liftoff with reduced situational awareness of the airport environment.",
            "font_name": "TimesNewRomanPSMT",
            "font_size": 10.0,
            "color": "#000000",
            "is_bold": false,
            "is_italic": false,
            "bbox": [
