              272.3953857421875
            ]
          },
          {
            "type": "text",
            "text": "The engineers who design a helicopter ",
            "font_name": "TimesNewRoman",
            "font_size": 10.0,
            "color": "#000000",
            "is_bold": false,
            "is_italic": false,
            "bbox": [
              158.92999267578125,
