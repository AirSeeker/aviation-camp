          {
            "type": "text",
            "text": "Before an aircraft CG can be computed, certain information ",
            "font_name": "TimesNewRoman",
            "font_size": 10.0,
            "color": "#000000",
            "is_bold": false,
            "is_italic": false,
            "bbox": [
              36.0,
              284.8199462890625,
              275.50799560546875,
              294.8199462890625
