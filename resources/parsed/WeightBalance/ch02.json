            "is_italic": false,
            "bbox": [
              285.0,
              299.26995849609375,
              524.510986328125,
              309.26995849609375
            ]
          },
          {
            "type": "text",
            "text": "for every certificated aircraft in the Type Certificate Data ",
            "font_name": "TimesNewRoman",
            "font_size": 10.0,
            "color": "#000000",
            "is_bold": false,
            "is_italic": false,
            "bbox": [
              36.0,
              309.8199462890625,
              275.50299072265625,
              319.8199462890625
            ]
          },
          {
            "type": "text",
            "text": "so that its operational CG falls outside this allowable range. ",
